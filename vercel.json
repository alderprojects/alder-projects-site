{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 8 * * *"
    }
  ]
}
